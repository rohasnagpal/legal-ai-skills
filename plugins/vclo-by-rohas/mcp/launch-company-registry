#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ -n "${CODEX_MCP_NODE_PATH:-}" ] && [ -x "${CODEX_MCP_NODE_PATH}" ]; then
  exec "${CODEX_MCP_NODE_PATH}" "${SCRIPT_DIR}/company-registry-server.mjs"
fi

if command -v node >/dev/null 2>&1; then
  exec node "${SCRIPT_DIR}/company-registry-server.mjs"
fi

echo "vCLO company-registry connector requires Node.js or CODEX_MCP_NODE_PATH." >&2
exit 127
