#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "${SCRIPT_DIR}/node-locator.sh"

if NODE_BIN=$(find_node); then
  exec "${NODE_BIN}" "${SCRIPT_DIR}/sanctions-screening-server.mjs"
fi

echo "Legal AI Skills sanctions screening needs Node.js 18 or later. Install Node.js or set CODEX_MCP_NODE_PATH." >&2
exit 127
